# プッシュ通知トピック名（ntfy.sh）
# 実際の値は .env.local に設定し、Vercel 環境変数にも同じ値を登録する
VITE_NTFY_TOPIC=your-ntfy-topic-here

# OCR fallback keys used by scraper/GitHub Actions.
# RapidOCR is local and does not need an API key.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OCR_SPACE_API_KEY=
OCR_SPACE_ENGINE=1

# OCR に使うモデルIDの上書き（未指定なら scraper/index.js の候補リストから
# 実行時にプロバイダの models API を照会して自動選択する）。
# プロバイダがモデルを廃止したときの緊急避難用。
GROQ_OCR_MODEL=
GEMINI_OCR_MODEL=
MISTRAL_OCR_MODEL=

# 外部リクエストのタイムアウト（ミリ秒。既定 45000）
FETCH_TIMEOUT_MS=
