# 環境変数の一覧（キーのみ。値は入れない）
# 実際の値は Vercel の Environment Variables / GitHub Secrets / ローカルの .env.local にだけ設定する。
# 秘密値（トークン・パスワード・ハッシュ・鍵）をこのファイル・リポジトリ・チャットに書かないこと。
# 用途と既定値の詳細は DEPLOY.md。

# ── データストア（Upstash Redis） ─────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── 管理者アカウント・セッション ─────────────────────────────
# base64(JSON 配列)。作り方は docs/ADMIN_ACCOUNT_SETUP.md（アカウント管理機能の導入後は廃止予定）
ADMIN_ACCOUNTS_B64=
ADMIN_SESSION_TTL=
ADMIN_SESSION_IDLE=
ADMIN_LOGIN_MAX_FAILS=
ADMIN_LOGIN_LOCK_SEC=
ADMIN_LOGIN_LOCK_MAX_SEC=
ADMIN_LOGIN_LOCK_FACTOR=
ADMIN_LOGIN_LEVEL_TTL=
# 重要操作の再認証（パスワード再入力）の有効秒数（既定 300）
STEP_UP_TTL_SEC=

# 旧方式の互換（正式運用ではすべて false）
LEGACY_PLAINTEXT_PASSWORDS=false
LEGACY_HEADER_AUTH=false
LEGACY_ADMIN_SECRET=false
# 旧共通管理者パスワード（正式運用では設定しない）
ADMIN_SECRET=

# ── API・監査・報告 ─────────────────────────────────────────
INTERNAL_API_SECRET=
AUDIT_MAX=
REPORT_TTL_DAYS=

# ── 公開URL・許可オリジン ─────────────────────────────────────
SITE_URL=
SITE_ORIGINS=

# ── Web Push ───────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
NOTIFY_SECRET=

# ── 検証環境（Preview）──────────────────────────────────────
# Preview 環境だけに true。本番と別の Redis を設定したことの確認（docs/PREVIEW_ENVIRONMENT.md）
PREVIEW_DATA_ISOLATED=

# ── ローカル開発用 ─────────────────────────────────────────
# ローカル HTTP で管理画面を試すときだけ true（Cookie の Secure 属性を外す）
SESSION_INSECURE=
ENABLE_DEV_STAFF=
EVENTS_ARCHIVE_PATH=

# ── スクレイパー（GitHub Actions）────────────────────────────
# OCR の外部キー（RapidOCR / Tesseract はローカルでキー不要）
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OCR_SPACE_API_KEY=
OCR_SPACE_ENGINE=1
# OCR に使うモデルIDの上書き（未指定なら実行時に自動選択。プロバイダがモデルを廃止したときの緊急避難用）
GROQ_OCR_MODEL=
GEMINI_OCR_MODEL=
MISTRAL_OCR_MODEL=
# 外部リクエストのタイムアウト（ミリ秒。既定 45000）
FETCH_TIMEOUT_MS=
LLM_RECHECK_LIMIT=
# 運営者向けの監視通知（ntfy トピック。GitHub Secrets のみ）
NTFY_ADMIN_TOPIC=
